# =============================================================================
# Plateforme-AFD — variables PRODUCTION (CyberPanel / VPS)
# Emplacement VPS UNIQUEMENT :
#   $VPS_APP_PATH/shared/.env.production
#   chmod 600 shared/.env.production
# Ne jamais committer de vraies clés.
# Ne jamais préfixer un secret avec NEXT_PUBLIC_.
# Projet Supabase : mxxuxnoqnwjygawvvhcb
# Guide : docs/PRODUCTION_ENVIRONMENT_VARIABLES.md
# =============================================================================

# --- Runtime Node (PM2 / standalone) -----------------------------------------
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

# --- App / site (public) -----------------------------------------------------
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://afd-rdc.org
NEXT_PUBLIC_APP_NAME=Plateforme-AFD
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Supabase (public) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://mxxuxnoqnwjygawvvhcb.supabase.co
# Au moins UNE des deux clés publiques :
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=true

# --- Supabase (serveur uniquement — JAMAIS NEXT_PUBLIC_) ---------------------
SUPABASE_SERVICE_ROLE_KEY=

# --- Feature flags public ----------------------------------------------------
# false recommandé en production réelle (données métier).
NEXT_PUBLIC_ENABLE_ADMIN_DEMO_DATA=false
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=false
NEXT_PUBLIC_ENABLE_SPONTANEOUS_APPLICATIONS=false
NEXT_PUBLIC_ENABLE_WATER_RIPPLE=true
NEXT_PUBLIC_ENABLE_SECTION_ANIMATIONS=true
NEXT_PUBLIC_ENABLE_MOBILE_RAILS=true
# Newsletter Google OAuth (visible si provider Google activé dans Supabase)
NEXT_PUBLIC_NEWSLETTER_GOOGLE_OAUTH_ENABLED=true

# --- Contact public → SMTP (serveur uniquement) ------------------------------
CONTACT_NOTIFICATION_ENABLED=true
CONTACT_NOTIFICATION_EMAIL=contactafdrdc@gmail.com
CONTACT_FROM_EMAIL=admin@afd-rdc.org
CONTACT_FROM_NAME=Site officiel AFD
CONTACT_AUTO_REPLY_ENABLED=true

# --- Messagerie / SMTP CyberPanel (serveur uniquement) -----------------------
MAIL_DOMAIN=afd-rdc.org
MAIL_WEBMAIL_URL=
MAIL_IMAP_HOST=afd-rdc.org
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=afd-rdc.org
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USERNAME=admin@afd-rdc.org
MAIL_SMTP_PASSWORD=
# Activer uniquement après test SMTP réel
MAIL_INTEGRATED_ENABLED=false

# CyberPanel (liens panneau / API optionnelle — ne pas y mettre le MDP admin)
CYBERPANEL_PANEL_URL=https://panel.afd-rdc.org:8090
CYBERPANEL_API_ENABLED=false
CYBERPANEL_API_USER=
CYBERPANEL_API_TOKEN=

# --- OCR (serveur) -----------------------------------------------------------
OCR_CLOUD_ENABLED=false
OCR_PROVIDER=native
OCR_MAX_FILE_SIZE_MB=25
OCR_MAX_PAGES=100
OCR_DEFAULT_LANGUAGE=fr
OCR_ORGANISATION_ID=afd-asbl

# --- Newsletter / email marketing (optionnel) --------------------------------
NEWSLETTER_SEND_ENABLED=false
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Paiement carte Visa/Mastercard (désactivé — contrat marchand AFD requis)
CARD_PAYMENT_ENABLED=false

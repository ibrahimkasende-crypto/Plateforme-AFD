# Auth admin — Redirect URLs Supabase : {SITE_URL}/auth/callback
# Google OAuth (newsletter « Continuer avec Google ») :
#   Supabase → Authentication → Providers → Google (Client ID / Secret)
#   Redirect URL autorisée : {SITE_URL}/auth/callback
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://afd-rdc.org
NEXT_PUBLIC_SUPABASE_URL=
# Préférez la clé anon JWT (eyJ...) depuis Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ou clé publishable (sb_publishable_...) si vous n’avez que celle-ci
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_NAME=Plateforme-AFD

# Contenu de démonstration (carte provinces, etc.) — jamais présenté comme officiel
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=false

# Données de démonstration du dashboard admin (is_demo = true, jamais officielles)
# PRODUCTION : toujours false
NEXT_PUBLIC_ENABLE_ADMIN_DEMO_DATA=false

# Candidatures spontanées sur /rejoindre-equipe
NEXT_PUBLIC_ENABLE_SPONTANEOUS_APPLICATIONS=false

# Effets visuels site public (desktop / motion / rails mobiles)
NEXT_PUBLIC_ENABLE_WATER_RIPPLE=true
NEXT_PUBLIC_ENABLE_SECTION_ANIMATIONS=true
NEXT_PUBLIC_ENABLE_MOBILE_RAILS=true

# Intégrations optionnelles — désactivées par défaut (SERVEUR uniquement)
NEWSLETTER_SEND_ENABLED=false
SERDIPAY_ENABLED=false
OCR_CLOUD_ENABLED=false

# SerdiPay — variables SERVEUR uniquement (jamais NEXT_PUBLIC_)
SERDIPAY_ENVIRONMENT=
SERDIPAY_BASE_URL=
SERDIPAY_MERCHANT_ID=
SERDIPAY_API_KEY=
SERDIPAY_API_SECRET=
SERDIPAY_WEBHOOK_SECRET=
SERDIPAY_CALLBACK_URL=
SERDIPAY_RETURN_URL=
SERDIPAY_DEFAULT_CURRENCY=USD

# --- OCR / Import intelligent (SERVEUR uniquement, jamais NEXT_PUBLIC_) ---
OCR_PROVIDER=native
OCR_MAX_FILE_SIZE_MB=25
OCR_MAX_PAGES=100
OCR_DEFAULT_LANGUAGE=fr
OCR_SECONDARY_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.75
OCR_ENABLE_TABLE_EXTRACTION=true
OCR_ENABLE_SIGNATURE_DETECTION=true
OCR_ORGANISATION_ID=afd-asbl
OCR_WORKER_SECRET=
OCR_WORKER_POLL_MS=4000
SUPABASE_SERVICE_ROLE_KEY=

# Azure Document Intelligence (optionnel)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Google Document AI (optionnel — SDK officiel requis)
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# AWS Textract (optionnel — SDK officiel requis)
AWS_TEXTRACT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

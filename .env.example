# =============================================================================
# Plateforme-AFD — variables d'environnement (EXEMPLES uniquement)
# Copiez vers .env.local (dev) ou .env.production (CyberPanel / VPS).
# Modèle prod dédié : .env.production.example — guide : docs/CYBERPANEL_PRODUCTION_DEPLOYMENT.md
# Ne jamais committer de vraies clés. Ne jamais préfixer un secret avec NEXT_PUBLIC_.
# Projet Supabase cible : mxxuxnoqnwjygawvvhcb (https://mxxuxnoqnwjygawvvhcb.supabase.co)
# =============================================================================

# --- App / site (public) -----------------------------------------------------
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://afd-rdc.org
NEXT_PUBLIC_APP_NAME=Plateforme-AFD
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Supabase (public) -------------------------------------------------------
# URL du projet (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Clé anon JWT (eyJ...) — recommandée
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key
# Ou clé publishable (sb_publishable_...) si vous n’avez que celle-ci
# Au moins UNE des deux (ANON ou PUBLISHABLE) est obligatoire.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# --- Supabase (serveur uniquement) -------------------------------------------
# Settings → API → service_role — JAMAIS NEXT_PUBLIC_ — OBLIGATOIRE pour
# invitations admin, OCR worker, seeds scripts, uploads service.
# Sur Hostinger : Environment Variables → SUPABASE_SERVICE_ROLE_KEY → Redeploy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias accepté (même valeur secrète, jamais NEXT_PUBLIC_) :
# SUPABASE_SECRET_KEY=
# Upload banque d’images → Storage : npm run media:upload-bank
# (bucket public afd-media/banque/…)

# Connexion PostgreSQL directe / pooler (scripts seed / migrations manuelles).
# Pas utilisée par l’app Next.js runtime (client Supabase JS uniquement).
# Pooler IPv4 (Transaction) recommandé : aws-0-REGION.pooler.supabase.com:6543
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# DIRECT_URL / POSTGRES_URL / SUPABASE_DB_URL : non utilisés par ce projet.

# --- Feature flags public ----------------------------------------------------
# IMPORTANT Hostinger / démo + CRUD :
# - false = lire/écrire dans Supabase (CRUD réel, pas de mocks UI).
# - true = activer l’affichage des données de démonstration (is_demo) pour présentation client.
# Sur Hostinger démo client : passez les deux à true, puis npm run demo:seed -- --execute
NEXT_PUBLIC_ENABLE_DEMO_CONTENT=true
NEXT_PUBLIC_ENABLE_ADMIN_DEMO_DATA=true
# Alias obsolète de ENABLE_ADMIN_DEMO_DATA (évitez en prod)
# NEXT_PUBLIC_AFD_ADMIN_DEMO=false
NEXT_PUBLIC_ENABLE_SPONTANEOUS_APPLICATIONS=false
NEXT_PUBLIC_ENABLE_WATER_RIPPLE=true
NEXT_PUBLIC_ENABLE_SECTION_ANIMATIONS=true
NEXT_PUBLIC_ENABLE_MOBILE_RAILS=true

# Newsletter Google OAuth (bouton « Continuer avec Google »)
# false = masqué ; true ou absent = visible si provider Google activé dans Supabase
# NEXT_PUBLIC_NEWSLETTER_GOOGLE_OAUTH_ENABLED=true
# Redirect Supabase Auth : https://<PROJECT_REF>.supabase.co/auth/v1/callback
# Redirect app : {NEXT_PUBLIC_SITE_URL}/auth/callback

# Réseaux sociaux (optionnel)
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_TIKTOK=
# NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/243985710039

# --- Email / newsletter (serveur) --------------------------------------------
NEWSLETTER_SEND_ENABLED=false
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Contact public → notification SMTP (serveur uniquement) -----------------
# Ne jamais préfixer NEXT_PUBLIC_. Ne jamais committer MAIL_SMTP_PASSWORD.
CONTACT_NOTIFICATION_ENABLED=true
CONTACT_NOTIFICATION_EMAIL=contactafdrdc@gmail.com
CONTACT_FROM_EMAIL=admin@afd-rdc.org
CONTACT_FROM_NAME=Site officiel AFD
CONTACT_AUTO_REPLY_ENABLED=true

# --- Messagerie professionnelle @afd-rdc.org (serveur uniquement) ------------
# Ne jamais préfixer NEXT_PUBLIC_. Ne pas y mettre le mot de passe CyberPanel admin.
MAIL_DOMAIN=afd-rdc.org
MAIL_WEBMAIL_URL=
MAIL_IMAP_HOST=afd-rdc.org
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=afd-rdc.org
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USERNAME=admin@afd-rdc.org
MAIL_SMTP_PASSWORD=
# Activer uniquement après validation IMAP/SMTP (phase 2 messagerie intégrée)
MAIL_INTEGRATED_ENABLED=false

# CyberPanel (serveur) — panneau https://panel.afd-rdc.org:8090
CYBERPANEL_PANEL_URL=https://panel.afd-rdc.org:8090
CYBERPANEL_API_ENABLED=false
CYBERPANEL_API_USER=
CYBERPANEL_API_TOKEN=

# --- Paiement carte Visa/Mastercard (serveur) — désactivé tant que contrat AFD absent
# Provider envisagé pour étude : Equity BCDC Eazzy e-Commerce / CyberSource
# Ne pas réutiliser SerdiPay (Campus Food) — périmètre strictement séparé.
CARD_PAYMENT_ENABLED=false
CARD_PAYMENT_PROVIDER_ID=
CARD_PAYMENT_BASE_URL=
CARD_PAYMENT_MERCHANT_ID=
CARD_PAYMENT_API_KEY=
CARD_PAYMENT_API_SECRET=
CARD_PAYMENT_WEBHOOK_SECRET=
CARD_PAYMENT_CALLBACK_URL=
CARD_PAYMENT_RETURN_URL=
CARD_PAYMENT_DEFAULT_CURRENCY=USD

# --- OCR / Import intelligent (serveur) --------------------------------------
OCR_CLOUD_ENABLED=false
OCR_PROVIDER=native
OCR_MAX_FILE_SIZE_MB=25
OCR_MAX_PAGES=100
OCR_DEFAULT_LANGUAGE=fr
OCR_SECONDARY_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.75
OCR_ENABLE_TABLE_EXTRACTION=true
OCR_ENABLE_SIGNATURE_DETECTION=true
OCR_ORGANISATION_ID=afd-asbl
OCR_WORKER_SECRET=
OCR_WORKER_POLL_MS=4000

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_TEXTRACT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Ops / scripts (serveur) -------------------------------------------------
# PLATFORM_OWNER_EMAIL=owner@example.com
# BACKUP_STATUS_PROVIDER=
# BACKUP_LAST_KNOWN_AT=
# CONFIRM=yes
# LEGACY_SUPABASE_URL=
# LEGACY_SUPABASE_ANON_KEY=

# --- E2E / Playwright (local uniquement, jamais en prod Hostinger) -----------
# AFD_E2E_ADMIN_EMAIL=
# AFD_E2E_ADMIN_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3010
# AFD_REQUIRE_RLS=0

# --- Création admins principaux (temporaire, serveur uniquement) -------------
# Ne jamais committer les valeurs. Supprimer après exécution réussie.
AFD_CHRISTIAN_TEMP_PASSWORD=
AFD_ESTHER_TEMP_PASSWORD=

# =============================================================================
# Variables NON utilisées par le runtime Next.js (ne pas configurer sur Hostinger) :
#   DIRECT_URL, POSTGRES_URL, SUPABASE_DB_URL,
#   SUPABASE_KEY, SUPABASE_ANON_KEY (sans NEXT_PUBLIC_),
#   SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_JWT_SECRET,
#   E2E_ADMIN_EMAIL / E2E_ADMIN_PASSWORD (utiliser AFD_E2E_* à la place)
# Alias serveur accepté : SUPABASE_SECRET_KEY (= SERVICE_ROLE_KEY)
# =============================================================================

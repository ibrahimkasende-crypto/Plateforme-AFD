    "seed:presentation:clean": "npx tsx scripts/clean-presentation.ts",
    "seed:complete-admin": "npx tsx scripts/seed-complete-admin-presentation.ts",
    "seed:complete-admin:clean": "npx tsx scripts/clean-complete-admin-presentation.ts",
    "seed:hr": "npx tsx scripts/seed-hr-presentation.ts",
    "seed:hr:clean": "npx tsx scripts/clean-hr-presentation.ts",
    "seed:complete-platform": "npx tsx scripts/seed-complete-platform-presentation.ts",
    "seed:complete-platform:clean": "npx tsx scripts/clean-complete-platform-presentation.ts",
    "verify:presentation": "npx tsx scripts/verify-presentation-consistency.ts",
    "bootstrap:platform-owner": "npx tsx scripts/bootstrap-platform-owner.ts",
    "test:e2e": "playwright test",
    "test:e2e:operationnel": "playwright test tests/e2e/operationnel-modules-access.spec.ts --project=desktop-1440 --workers=1",
    "test:e2e:install": "playwright install chromium"
